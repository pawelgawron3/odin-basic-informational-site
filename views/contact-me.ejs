<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact - Morning Haze</title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="shortcut icon" href="/top_favicon.svg" type="image/svg+xml" />
  </head>

  <body>
    <%- include('partials/header', { links }) %>

    <main class="main-content">
      <section class="contact-section">
        <h2 class="section-title">Get in Touch</h2>

        <p>
          Have a question, want to say hello, or simply looking for a good cup
          of coffee? We'd love to hear from you.
        </p>
      </section>

      <section class="contact-section">
        <h2 class="section-title">Visit Us</h2>

        <address>
          24 Market Street<br />
          Bristol, UK
        </address>

        <p><strong>Phone:</strong> +44 90 1234 5678</p>

        <p><strong>Email:</strong> morninghaze@example.com</p>
      </section>

      <section class="contact-section">
        <h2 class="section-title">Send Us a Message</h2>

        <form class="contact-form" action="/contact" method="POST">
          <div class="form-group">
            <label for="name">Your Name</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Paul Kowalski"
              required
            />
          </div>

          <div class="form-group">
            <label for="email">Email Address</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="example1@example.com"
              required
            />
          </div>

          <div class="form-group">
            <label for="message">Your Message</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              placeholder="Type here..."
              required
            ></textarea>
          </div>

          <button type="submit" class="button">Send Message</button>
        </form>
      </section>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
