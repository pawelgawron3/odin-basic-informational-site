<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Morning Haze</title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="shortcut icon" href="/top_favicon.svg" type="image/svg+xml" />
  </head>

  <body>
    <%- include('partials/header', { links }) %>

    <main class="main-content">
      <section class="intro-section">
        <h2 class="section-title">Welcome to Morning Haze!</h2>

        <p class="intro-text">
          Morning Haze is an independent coffee shop in the heart of the city,
          serving carefully crafted coffee in a warm and welcoming atmosphere.
          Whether you're looking for your morning espresso, a quiet place to
          work, or a moment to slow down, there's always a seat waiting for you.
        </p>
      </section>

      <section class="favorites-section">
        <h2 class="section-title">Our Favorites</h2>

        <div class="coffee-list">
          <span class="coffee-item">Espresso</span>
          <span class="coffee-item">Flat White</span>
          <span class="coffee-item">Cinnamon Latte</span>
        </div>
      </section>

      <section class="hours-section">
        <h2 class="section-title">Opening Hours</h2>

        <p class="opening-hours">
          Monday - Friday <span class="hours">7:00 - 19:00</span>
        </p>
      </section>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
